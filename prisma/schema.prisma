generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model clientes {
  id                 Int       @id @default(autoincrement())
  cpf_cnpj           String?   @db.VarChar(20)
  inscricao_estadual String?   @db.VarChar(30)
  nome               String    @db.VarChar(100)
  telefone_1         String?   @db.VarChar(20)
  telefone_2         String?   @db.VarChar(20)
  cep                String?   @db.VarChar(10)
  logradouro         String?   @db.VarChar(150)
  numero             String?   @db.VarChar(20)
  bairro             String?   @db.VarChar(100)
  cidade             String?   @db.VarChar(100)
  estado             String?   @default("PA") @db.VarChar(2)
  saldo_credito      Decimal?  @default(0) @db.Decimal(10, 2)
  ativo              Boolean?  @default(true)
  criado_em          DateTime? @default(now()) @db.Timestamp(0)
  pedidos            pedidos[]
}

model pedidos {
  id               Int            @id @default(autoincrement())
  cliente_id       Int?
  ativo            Boolean?       @default(true)
  data_pedido      DateTime?      @db.Date
  valor_total      Decimal?       @db.Decimal(10, 2)
  ajuste           Decimal?       @db.Decimal(10, 2)
  status_geral     String?        @default("Ativa") @db.VarChar(30)
  status_pagamento String?        @default("Pendente") @db.VarChar(30)
  status_entrega   String?        @default("Pendente") @db.VarChar(30)
  observacoes      String?        @db.Text
  criado_em        DateTime?      @default(now()) @db.Timestamp(0)
  clientes         clientes?      @relation(fields: [cliente_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  entregas         entregas[]
  itens_pedido     itens_pedido[]
  pagamentos       pagamentos[]

  @@index([cliente_id])
}

model produtos {
  id             Int             @id @default(autoincrement())
  nome           String          @db.VarChar(50)
  preco          Decimal         @db.Decimal(10, 2)
  ativo          Boolean?        @default(true)
  itens_pedido   itens_pedido[]
  itens_entrega  itens_entrega[]
}

model itens_pedido {
  id             Int       @id @default(autoincrement())
  pedido_id      Int?
  produto_id     Int?
  quantidade     Int
  valor_unitario Decimal?  @db.Decimal(10, 2)
  pedidos        pedidos?  @relation(fields: [pedido_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  produtos       produtos? @relation(fields: [produto_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([pedido_id])
  @@index([produto_id])
}

model entregas {
  id             Int             @id @default(autoincrement())
  pedido_id      Int
  data_entrega   DateTime?       @db.Date
  local_entrega  String?         @db.VarChar(50)
  motorista      String?         @db.VarChar(100)
  placa_veiculo  String?         @db.VarChar(20)
  status_entrega String?         @default("Realizada") @db.VarChar(30)
  criado_em      DateTime?       @default(now()) @db.Timestamp(0)
  pedidos        pedidos         @relation(fields: [pedido_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  itens_entrega  itens_entrega[]

  @@index([pedido_id])
}

model itens_entrega {
  id         Int      @id @default(autoincrement())
  entrega_id Int
  produto_id Int
  quantidade Int
  entregas   entregas @relation(fields: [entrega_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  produtos   produtos @relation(fields: [produto_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([entrega_id])
  @@index([produto_id])
}

model pagamentos {
  id                Int       @id @default(autoincrement())
  pedido_id         Int?
  valor_pago        Decimal   @db.Decimal(10, 2)
  data_pagamento    DateTime? @db.Date
  forma_pagamento   String?   @db.VarChar(50)
  recebedor         String?   @db.VarChar(50)
  nome_pagador      String?   @db.VarChar(100)
  cpf_cnpj_pagador  String?   @db.VarChar(20)
  status_nota       String?   @default("Pendente") @db.VarChar(30)
  numero_nota       String?   @db.VarChar(50)
  data_emissao_nota DateTime? @db.Date
  criado_em         DateTime? @default(now()) @db.Timestamp(0)
  pedidos           pedidos?  @relation(fields: [pedido_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([pedido_id])
}

model usuarios {
  id         Int      @id @default(autoincrement())
  nome       String
  email      String   @unique
  senha_hash String
  ativo      Boolean  @default(true)
  criado_em  DateTime @default(now())
}

model formas_pagamento {
  id                  Int     @id @default(autoincrement())
  nome                String  @db.VarChar(50)
  ativo               Boolean @default(true)
  pagamento_posterior Boolean @default(false)
}

model locais_entrega {
  id    Int     @id @default(autoincrement())
  nome  String  @db.VarChar(50)
  ativo Boolean @default(true)
}

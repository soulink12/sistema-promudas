# Copiar para .env.docker no host da VPS e preencher os valores reais.
# Usado pelo serviço promudas-backend no docker-compose.yml.
# DATABASE_HOST fica fixo como "mysql" (nome do serviço no compose).

DATABASE_HOST=mysql
DATABASE_PORT=3306
DATABASE_NAME=sistema_mudas
DATABASE_USER=
DATABASE_PASSWORD=
# env_file não faz substituição de variável — escrever o usuário/senha reais aqui, não os nomes acima
DATABASE_URL=mysql://usuario:senha@mysql:3306/sistema_mudas

# Mesmo arquivo é lido pelo container da imagem oficial mysql (serviço
# "mysql" do compose), que só reconhece suas próprias variáveis — repetir os
# valores acima com esses nomes (mesmo usuário/senha/banco).
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=sistema_mudas
MYSQL_USER=
MYSQL_PASSWORD=

JWT_SECRET=

RESEND_API_KEY=
EMAIL_REMETENTE=
EMAIL_NOTIFICACAO_PEDIDOS=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

CADASTRO_USUARIOS_HABILITADO=false

# Token do túnel Cloudflare (gerado no dashboard ao criar o túnel), usado
# pelo serviço "cloudflared" do compose. Lido automaticamente pelo binário
# como variável de ambiente, não precisa passar via --token na linha de comando.
TUNNEL_TOKEN=
